{
  "name": "tweets-2-bsky",
  "version": "3.6.3",
  "description": "A powerful tool to crosspost Tweets to Bluesky, supporting threads, videos, and high-quality images.",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "setup": "bun install && bun run build",
    "prebuild": "bun scripts/check-bun.ts",
    "build": "tsc && vite build",
    "build:server": "tsc",
    "build:web": "vite build",
    "rebuild:native": "bash scripts/rebuild-native.sh",
    "run:once": "bun dist/index.js --run-once --no-web",
    "test:pipeline": "bun scripts/test-pipeline.ts",
    "test:twitter-metadata": "bun scripts/test-twitter-profile-metadata.ts",
    "test:twitter-fetch": "bun scripts/test-twitter-fetch.ts",
    "test:ad-tweet": "bun scripts/test-ad-tweet.ts",
    "test": "bun test tests/unit tests/integration tests/release",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun run build:web && bun run scripts/run-playwright.ts",
    "test:release": "bun test tests/release",
    "test:watch": "bun test --watch",
    "start": "bun dist/index.js",
    "cli": "bun src/cli.ts",
    "dev": "bun src/index.ts",
    "dev:web": "vite",
    "import": "bun src/index.ts --import-history",
    "lint": "biome check --write .",
    "lint:check": "biome lint .",
    "preview:web": "vite preview",
    "playwright:install": "playwright install chromium",
    "release": "semantic-release",
    "release:validate": "bun scripts/release-validation.ts",
    "verify:deps": "bun scripts/verify-scraper-compat.ts",
    "format": "biome format --write .",
    "typecheck": "bun run typecheck:server && bun run typecheck:web",
    "typecheck:server": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "check": "bun run verify:deps && bun run lint:check && bun run typecheck && bun run test:unit && bun run test:integration && bun run test:release && bun run build",
    "image:validate": "bun scripts/validate-image.ts",
    "test:deployment-ui": "bun scripts/run-playwright.ts test --config playwright.production.config.ts"
  },
  "keywords": [
    "bluesky",
    "twitter",
    "crosspost",
    "migration",
    "thread",
    "video"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "brace-expansion": "5.0.9",
    "qs": "6.16.0",
    "js-yaml": "4.3.2",
    "ip-address": "10.7.0"
  },
  "dependencies": {
    "@atproto/api": "0.20.44",
    "@google/generative-ai": "^0.24.1",
    "@the-convocation/twitter-scraper": "^0.22.3",
    "axios": "1.20.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "13.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "15.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "franc-min": "^6.2.0",
    "inquirer": "14.2.2",
    "iso-639-1": "^3.1.6",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "1.45.0",
    "puppeteer-core": "25.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/bun": "1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "postcss": "8.5.28",
    "semantic-release": "25.0.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "@tailwindcss/postcss": "4.3.3"
  }
}
