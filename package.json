{
  "name": "tweets-2-bsky",
  "version": "3.6.2",
  "description": "A powerful tool to crosspost Tweets to Bluesky, supporting threads, videos, and high-quality images.",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "setup": "bun install && bun run build",
    "prebuild": "bun scripts/check-bun.ts",
    "build": "tsc && vite build",
    "build:server": "tsc",
    "build:web": "vite build",
    "rebuild:native": "bash scripts/rebuild-native.sh",
    "run:once": "bun dist/index.js --run-once --no-web",
    "test:pipeline": "bun scripts/test-pipeline.ts",
    "test:twitter-metadata": "bun scripts/test-twitter-profile-metadata.ts",
    "test:twitter-fetch": "bun scripts/test-twitter-fetch.ts",
    "test:ad-tweet": "bun scripts/test-ad-tweet.ts",
    "test": "bun test tests/unit tests/integration tests/release",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:e2e": "bun run build:web && bun run scripts/run-playwright.ts",
    "test:release": "bun test tests/release",
    "test:watch": "bun test --watch",
    "start": "bun dist/index.js",
    "cli": "bun src/cli.ts",
    "dev": "bun src/index.ts",
    "dev:web": "vite",
    "import": "bun src/index.ts --import-history",
    "lint": "biome check --write .",
    "lint:check": "biome lint .",
    "preview:web": "vite preview",
    "playwright:install": "playwright install chromium",
    "release": "semantic-release",
    "release:validate": "bun scripts/release-validation.ts",
    "verify:deps": "bun scripts/verify-scraper-compat.ts",
    "format": "biome format --write .",
    "typecheck": "bun run typecheck:server && bun run typecheck:web",
    "typecheck:server": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "check": "bun run verify:deps && bun run lint:check && bun run typecheck && bun run test:unit && bun run test:integration && bun run test:release && bun run build"
  },
  "keywords": [
    "bluesky",
    "twitter",
    "crosspost",
    "migration",
    "thread",
    "video"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "brace-expansion": "5.0.8",
    "sigstore": "4.1.1"
  },
  "dependencies": {
    "@atproto/api": "^0.20.34",
    "@google/generative-ai": "^0.24.1",
    "@the-convocation/twitter-scraper": "^0.22.3",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "franc-min": "^6.2.0",
    "inquirer": "^13.4.3",
    "iso-639-1": "^3.1.6",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.553.0",
    "puppeteer-core": "^24.43.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.62.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.6",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.14",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^9.0.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sharp": "^0.31.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.23",
    "semantic-release": "24.2.9",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
