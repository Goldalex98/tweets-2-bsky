# --- Deployment ---
# X cookies, Bluesky app passwords, sources, destinations, routes, and the
# scheduler interval all live in configuration and are managed from the
# authenticated dashboard or the CLI. They are not environment variables.
# Only the manual live smoke scripts under scripts/ read TWITTER_AUTH_TOKEN and
# TWITTER_CT0 from here; the application itself never does.
PORT=3000
# Data directory holding config.json, database.sqlite, and .jwt-secret.
# TWEETS2BSKY_DATA_DIR=/app/data

# --- Secrets ---
# Session signing key. Must be at least 32 characters; production refuses to
# start with a shorter value. When unset, a persistent secret is generated in
# the data directory instead. Generate with: openssl rand -hex 32
# JWT_SECRET=
# Encrypts X cookies, app passwords, AI keys, and notification secrets at rest.
# Generate with: openssl rand -hex 32
# Losing this key makes encrypted full backups/configuration unrecoverable.
# CONFIG_ENCRYPTION_KEY=

# --- Optional ---
# Per-account watchdogs for scheduled sweeps and backfills. Defaults are 20 and
# 15 minutes; posting is paced 5-15s per item, so do not set these too low.
# SCHEDULED_ACCOUNT_TIMEOUT_MS=1200000
# BACKFILL_ACCOUNT_TIMEOUT_MS=900000
# Set only behind a trusted reverse proxy that overwrites forwarding headers.
# TRUST_PROXY=false
# Comma-separated browser origins allowed to make credentialed cross-origin requests.
# CORS_ALLOWED_ORIGINS=https://tweets.example.com
# JWT_EXPIRES_IN=7d
# Optional bearer TTL for CLI/automation tokens issued when login sets
# includeBearerToken: true. Browser sessions use the HttpOnly cookie instead.
# LOG_FORMAT=json enables structured JSON logs (default is human-readable).
# LOG_FORMAT=json
# ENABLE_PROMETHEUS_METRICS=true exposes authenticated /api/metrics/prometheus.
# ENABLE_PROMETHEUS_METRICS=false
# QUEUE_AGE_ALERT_MS=3600000
# Global X request pacing and durable worker controls.
# SCRAPER_MIN_GAP_MS=800
# SCRAPER_JITTER_MS=400
# Sustained X request ceiling, enforced over a rolling window. Spacing alone
# only bounds bursts, so this is what stops a backfill or retry loop from
# running hot for hours. Defaults suit 20-30 mirrored source accounts.
# SCRAPER_MAX_REQUESTS_PER_WINDOW=150
# SCRAPER_WINDOW_MS=900000
# Cooldown applied when X reports a limit without saying when it lifts. When X
# does send a reset, that value is used instead (capped by the maximum).
# SCRAPER_COOLDOWN_BASE_MS=30000
# SCRAPER_COOLDOWN_MAX_MS=900000
# Most source accounts fetched in a single sweep; the rest roll into the next.
# SCHEDULER_MAX_SOURCES_PER_SWEEP=25
# FETCH_CONCURRENCY=4
# POST_WORKER_CONCURRENCY=5
# POST_PACING_MIN_MS=3000
# POST_PACING_MAX_MS=8000
# QUEUE_MAX_ATTEMPTS=8
# SWEEP_FETCH_TIMEOUT_MS=180000
# Inbound normalized-post API. Keep the default body/rate limits unless your
# reverse proxy enforces stricter values. Production ingestion requires HTTPS.
# INGESTION_BODY_LIMIT=128kb
# INGESTION_RATE_LIMIT_PER_MINUTE=120
# Emergency development-only override; never enable on an Internet-facing host.
# ALLOW_INSECURE_INGESTION=false
# NOTE: BACKUP_MAX_BYTES is not read by this application; the backup size
# limit is fixed in code. Left here only as a placeholder for a future release.

# Webhook notifications are configured in the authenticated dashboard or CLI.
# Targets must use HTTPS and public DNS unless an admin explicitly enables
# the private-network override. URLs and HMAC secrets are never printed.

# --- Image Alt Text / AI Provider (Optional, disabled by default) ---
# Enabling Image Alt Text sends image bytes and limited post context to the
# configured provider for that purpose only. Translation, summarization,
# cleanup/rewrite, and hashtag suggestions are separate opt-ins in config/UI.
# Supports: gemini, openai, anthropic, custom
# Default provider is 'gemini' if GEMINI_API_KEY is present.

# 1. Google Gemini (Default)
# Get your API key from https://ai.google.dev/
GEMINI_API_KEY=

# 2. OpenAI / OpenRouter / Custom
# OPENAI_API_KEY=sk-...
# Provider, model, and base URL are NOT read from the environment — set them
# in the authenticated dashboard or config.json's `ai` object (provider:
# 'openai' or 'custom', model, baseUrl).

# 3. Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Provider/model are set in the dashboard or config.json's `ai` object
# (provider: 'anthropic', model, e.g. claude-3-5-sonnet-20241022).

# Generic Override (takes precedence)
# AI_API_KEY=
# Provider connectivity tests use a disclosed generated 1x1 transparent image,
# never user media. Request outcome/latency/provider metadata is stored without
# prompts, image bytes, or provider response content.
