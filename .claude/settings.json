{
  "permissions": {
    "allow": [
      "Bash(bun run check)",
      "Bash(bun run lint:check)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run test:unit:*)",
      "Bash(bun run test:integration:*)",
      "Bash(bun run test:release:*)",
      "Bash(bun test tests/:*)",
      "Bash(bun run typecheck:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.codex/hooks/block-sensitive-git.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.codex/hooks/remind-migration-tests.mjs\""
          }
        ]
      }
    ]
  }
}
