{
  "permissions": {
    "allow": [
      "Bash(bun run check)",
      "Bash(bun run lint:check)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run test:unit)",
      "Bash(bun run test:integration)",
      "Bash(bun run test:release)",
      "Bash(bun test tests/integration/database-migrations.test.ts)",
      "Bash(bun run typecheck:server)",
      "Bash(bun run typecheck:web)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.prod)",
      "Read(./.env.development)",
      "Read(./.env.dev)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.env.stage)",
      "Read(./.env.*.local)",
      "Read(./.env.bak)",
      "Read(./.env.backup)",
      "Read(./.env.old)",
      "Read(./.env.orig)",
      "Read(./.env.save)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-sensitive-git.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-migration-tests.mjs\""
          }
        ]
      }
    ]
  }
}
